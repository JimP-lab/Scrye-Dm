{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "scrye-mcp",
      "version": "0.1.0",
      "title": "Scrye"
    },
    "tools": [
      {
        "name": "get_scrye_pitch",
        "title": "Get Scrye pitch",
        "description": "Return a short description of Scrye — what it does, who it's for, and how to join the waitlist.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "join_waitlist",
        "title": "Join the Scrye waitlist",
        "description": "Submit an email address to the Scrye pre-launch waitlist. The email is sent to the same Formspark endpoint the website's signup form uses.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Email address to add to the waitlist."
            }
          },
          "required": [
            "email"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
